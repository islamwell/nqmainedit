PORT=3000
ADMIN_USER=admin
# create with: npm run hash -- "YourStrongPassword"
ADMIN_PASS_HASH='$2a$12$REPLACE_WITH_HASHED_PASSWORD'
SESSION_SECRET=put-a-long-random-string-here
COOKIE_SECURE=1 # 1 when using https, 0 for local testing
SITE_DIR=./site # the static site folder
SITE_URL=https://nurulquran.com
LECTURES_BASE=lectures # lectures go to /lectures/...
SERVE_SITE=1 # 1 = also serve the site locally for preview

# Optional publish command run when "Publish" button is clicked:
# Cloudflare Pages / Git commit & push:
# DEPLOY_CMD=git add -A && git commit -m "Update from admin" && git push
# Cloudflare Pages direct deploy:
# DEPLOY_CMD=npx wrangler pages deploy ./site --project-name=nurulquran
